[
  {
    "label": "Television: Find files",
    "command": "\"$HOME/.config/zed/bin/television-open\"",
    "args": [
      "files"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "shell": {
      "program": "/bin/bash"
    }
  },
  {
    "label": "Television: Search text",
    "command": "\"$HOME/.config/zed/bin/television-open\"",
    "args": [
      "text"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "shell": {
      "program": "/bin/bash"
    }
  }
]
