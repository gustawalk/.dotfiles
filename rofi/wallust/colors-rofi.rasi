 /* wallust template - colors-rofi */

* {
active-background: #818181;
active-foreground: #E0E0E0;
normal-background: #000000;
normal-foreground: #E0E0E0;
urgent-background: #949494;
urgent-foreground: #E0E0E0;

alternate-active-background: #6F6F6F;
alternate-active-foreground: #E0E0E0;
alternate-normal-background: #000000;
alternate-normal-foreground: #E0E0E0;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #E0E0E0;

selected-active-background: #949494;
selected-active-foreground: #E0E0E0;
selected-normal-background: #949494;
selected-normal-foreground: #E0E0E0;
selected-urgent-background: #818181;
selected-urgent-foreground: #E0E0E0;

background-color: #000000;
background: rgba(0,0,0,0.7);
foreground: #E0E0E0;
border-color: #818181;

color0: #000000;
color1: #363636;
color2: #454545;
color3: #535353;
color4: #616161;
color5: #6F6F6F;
color6: #7E7E7E;
color7: #CBCBCB;
color8: #8E8E8E;
color9: #494949;
color10: #5C5C5C;
color11: #6F6F6F;
color12: #818181;
color13: #949494;
color14: #A7A7A7;
color15: #CBCBCB;


}

